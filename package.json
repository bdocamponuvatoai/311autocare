{
  "name": "311-auto-care",
  "version": "2.0.0",
  "private": true,
  "description": "311 Auto Care LLC automotive website concept",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/fix-export-segments.mjs",
