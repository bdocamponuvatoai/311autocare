# Copy to .env.local (or set in your hosting provider) and adjust.
# All values are read at build time.

# Public origin used for canonical URLs, Open Graph tags, structured data,
# robots.txt and sitemap.xml. On Vercel it defaults to the production domain.
SITE_URL=https://www.example.com

# Set to "true" only after the owner has approved the content for launch.
# While false, pages are served with `noindex, nofollow` and robots.txt
# disallows crawling.
SITE_INDEXABLE=false
